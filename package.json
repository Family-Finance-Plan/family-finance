{
  "name": "family-finance",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm dev",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
