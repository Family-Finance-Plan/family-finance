  },
  "devDependencies": {
    "@family-finance/contracts": "workspace:*",
    "@nestjs/testing": "^12.6.0",
    "@swc/core": "^1.16.22",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
